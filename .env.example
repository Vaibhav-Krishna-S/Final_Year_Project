# Database Configuration (PostgreSQL recommended)
DATABASE_URL=postgresql://engagement_user:secure_password@localhost:5432/student_engagement
# Alternative: SQLite for testing
# DATABASE_URL=sqlite:///./engagement.db

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
LMS_API_KEY=demo_key

# Security
SECRET_KEY=demo_secret_key_for_testing_only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Settings
DEBUG=True
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000

# LMS Integration (Simulation Mode)
LMS_TYPE=mock  # Use mock instead of real LMS
LMS_BASE_URL=http://localhost:8000/mock-lms
LMS_CLIENT_ID=demo_client
LMS_CLIENT_SECRET=demo_secret

# AI Model Settings
GEMINI_MODEL=gemini-1.5-pro  # or gemini-2.5-flash
FACE_DETECTION_CONFIDENCE=0.7
EMOTION_DETECTION_CONFIDENCE=0.6
ENGAGEMENT_THRESHOLD=0.5